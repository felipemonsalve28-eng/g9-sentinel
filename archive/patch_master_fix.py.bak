import os
import re
import shutil
import sqlite3

# Configuración
BASE_DIR = '/home/felipemonsalve28/g9_production'
DB_PATH = os.path.join(BASE_DIR, 'data', 'g9_market.db')
TARGET_MODEL = 'gemini-2.5-flash'

# Modelos fantasma o desactualizados a buscar
MODELS_TO_REPLACE = [
    r'gemini-3-flash-preview',
    r'gemini-3-flash',
    r'gemini-2\.0-flash'
]

def create_backup(file_path):
    """Crea una copia de seguridad del archivo antes de modificarlo."""
    backup_path = f"{file_path}.bak"
    shutil.copy2(file_path, backup_path)

def patch_models():
    print(f"🛠️ Iniciando cacería del modelo fantasma en {BASE_DIR}...\n")
    files_patched = 0
    
    # Recorremos el proyecto ignorando el entorno virtual
    for root, dirs, files in os.walk(BASE_DIR):
        if 'venv' in root or '__pycache__' in root or '.git' in root:
            continue
            
        for file in files:
            if file.endswith('.py'):
                file_path = os.path.join(root, file)
                
                with open(file_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                original_content = content
                
                # Buscamos y reemplazamos cada modelo obsoleto
                for old_model in MODELS_TO_REPLACE:
                    # Usamos regex para atrapar comillas simples o dobles
                    pattern = r'([\'\"])' + old_model + r'([\'\"])'
                    replacement = r'\g<1>' + TARGET_MODEL + r'\g<2>'
                    content = re.sub(pattern, replacement, content)
                
                # Solo reescribimos si hubo cambios reales
                if content != original_content:
                    create_backup(file_path)
                    with open(file_path, 'w', encoding='utf-8') as f:
                        f.write(content)
                    print(f"✅ Corregido: {os.path.relpath(file_path, BASE_DIR)}")
                    files_patched += 1

    if files_patched == 0:
        print("⚡ No se encontraron modelos obsoletos. El código ya está alineado.")
    else:
        print(f"\n🎯 Total de archivos unificados a {TARGET_MODEL}: {files_patched}")

def patch_database():
    print("\n🗄️ Verificando integridad de la Base de Datos...")
    # Usamos la ruta original que vimos en tu brain.py (en la raíz)
    memory_db_path = os.path.join(BASE_DIR, 'g9_memory.db')
    
    if not os.path.exists(memory_db_path):
        print(f"⚠️ No se encontró la DB en {memory_db_path}. Omitiendo parche SQL.")
        return

    try:
        conn = sqlite3.connect(memory_db_path)
        cursor = conn.cursor()
        cursor.execute("ALTER TABLE ai_decisions ADD COLUMN indicators_snapshot TEXT;")
        conn.commit()
        print("✅ Columna 'indicators_snapshot' inyectada correctamente.")
    except sqlite3.OperationalError as e:
        if "duplicate column name" in str(e).lower():
            print("✅ La estructura de la tabla ya es correcta (columna existente).")
        else:
            print(f"❌ Error SQL inesperado: {e}")
    finally:
        if 'conn' in locals():
            conn.close()

if __name__ == "__main__":
    patch_models()
    patch_database()
    print("\n🚀 PARCHE APLICADO CON ÉXITO. El G9-Sentinel está listo para iniciar.")

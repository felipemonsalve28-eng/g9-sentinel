import os

def fix_g9():
    print("🔧 Reparando G9-Sentinel V12.1...")
    
    # 1. Reparar brain.py (Sintaxis SQL limpia)
    with open('brain.py', 'r') as f:
        content = f.read()
    
    # Limpiamos el SQL de creación
    content = content.replace("-- Snapshot de RSI, BB, CVD", "")
    # Aseguramos que json esté importado
    if "import json" not in content:
        content = "import json\n" + content
        
    with open('brain.py', 'w') as f:
        f.write(content)

    # 2. Migrar engine.py al nuevo SDK google.genai
    with open('engine.py', 'r') as f:
        lines = f.readlines()

    new_lines = []
    for line in lines:
        if "import google.generativeai as genai" in line:
            new_lines.append("from google import genai\n")
        elif "genai.configure" in line:
            continue # El nuevo SDK no usa configure global igual
        elif "model = genai.GenerativeModel" in line:
            new_lines.append("client_gemini = genai.Client(api_key=os.getenv('GEMINI_API_KEY'))\n")
        elif "response = model.generate_content(prompt)" in line:
            new_lines.append("            response = client_gemini.models.generate_content(model='gemini-2.0-flash', contents=prompt)\n")
        else:
            new_lines.append(line)

    with open('engine.py', 'w') as f:
        f.writelines(new_lines)
    
    print("✅ Reparación completada. SQL limpio y SDK actualizado.")

if __name__ == "__main__":
    fix_g9()

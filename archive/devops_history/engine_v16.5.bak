import os
import json
import asyncio
import warnings
import httpx
import pandas as pd
import pandas_ta as ta
from datetime import datetime, timedelta
from dotenv import load_dotenv
from google import genai
from lnmarkets_sdk.v3.http.client import APIAuthContext, APIClientConfig, LNMClient
from lnmarkets_sdk.v3.models.futures_isolated import FuturesOrder
import lnmarkets_sdk.v3.models.futures_isolated as iso_models

from core.brain import G9Brain
from core.notifier import G9Notifier

warnings.filterwarnings('ignore')
load_dotenv('/home/felipemonsalve28/g9_production/.env')

class G9SentinelEngine:
    def __init__(self):
        self.brain = G9Brain()
        self.notifier = G9Notifier()
        self.model_name = "gemini-2.5-flash"
        self.client_gemini = genai.Client(api_key=os.getenv('GEMINI_API_KEY'))
        self.config_lnm = APIClientConfig(
            authentication=APIAuthContext(
                key=os.getenv('LNM_KEY'), secret=os.getenv('LNM_SECRET'), passphrase=os.getenv('LNM_PASSPHRASE')
            ), 
            network="mainnet", timeout=60.0
        )
        self.last_strategic_run = datetime.min
        self.fast_cycle_minutes = 5
        self.strategic_cycle_minutes = 15
        self.running = True
        self.last_tg_update_id = 0
        self.price_history = [] # Memoria volatil para RSI Sintético

    def round_to_tick(self, val):
        try: return round(float(val) * 2) / 2
        except: return None

    async def telegram_listener(self):
        token, allowed_id = os.getenv('TELEGRAM_TOKEN'), os.getenv('TELEGRAM_CHAT_ID')
        url = f"https://api.telegram.org/bot{token}/getUpdates"
        async with httpx.AsyncClient(timeout=30.0) as client:
            while self.running:
                try:
                    resp = await client.get(url, params={"offset": self.last_tg_update_id + 1})
                    if resp.status_code == 200:
                        for up in resp.json().get("result", []):
                            self.last_tg_update_id = up["update_id"]
                            msg = up.get("message", {})
                            if str(msg.get("chat", {}).get("id")) == allowed_id:
                                if msg.get("text") == "/status": await self.send_tg_status()
                                elif msg.get("text") == "/stop": os._exit(0)
                except: pass
                await asyncio.sleep(5)

    async def send_tg_status(self):
        try:
            async with LNMClient(self.config_lnm) as lnm:
                acc = await lnm.account.get_account()
                ticker = await lnm.futures.get_ticker()
                self.notifier.send_alert(f"🏦 <b>STATUS V17.5</b>\nSATS: {acc.balance}\nBTC: ${ticker.last_price}\nHistorial: {len(self.price_history)} ticks")
        except: pass

    async def get_market_signals(self, client, current_price):
        # Guardamos el precio actual en el historial
        self.price_history.append(current_price)
        if len(self.price_history) > 50: self.price_history.pop(0)

        try:
            # Intento 1: API oficial
            data = await client.futures.get_candles({"limit": 20})
            closes = [float(getattr(c, 'close', c.get('close') if isinstance(c, dict) else c[4])) for c in data if c]
            if len(closes) >= 14:
                rsi = ta.rsi(pd.Series(closes), length=14).iloc[-1]
                return round(float(rsi), 2)
        except: pass

        # Intento 2: RSI Sintético (basado en los latidos del bot)
        if len(self.price_history) >= 14:
            rsi = ta.rsi(pd.Series(self.price_history), length=14).iloc[-1]
            return round(float(rsi), 2) if not pd.isna(rsi) else 50.0
        
        return 50.0

    async def run_trading_cycle(self):
        asyncio.create_task(self.telegram_listener())
        print(f"⚡ G9-SENTINEL V17.5: RSI SINTÉTICO ACTIVADO")
        while self.running:
            try:
                async with LNMClient(self.config_lnm) as lnm:
                    ticker = await lnm.futures.get_ticker()
                    price = float(ticker.last_price)
                    rsi = await self.get_market_signals(lnm, price)
                    trades = await lnm.futures.isolated.get_running_trades()
                    account = await lnm.account.get_account()
                    
                    now = datetime.now()
                    is_strategic = (now - self.last_strategic_run) >= timedelta(minutes=self.strategic_cycle_minutes)
                    print(f"\n[HEARTBEAT] {now.strftime('%H:%M:%S')} | BTC: ${price} | RSI: {rsi} | Ticks: {len(self.price_history)}")

                    for pos in trades:
                        if is_strategic or abs(pos.pl) > 3000:
                            await self.audit_position(lnm, pos, rsi, price)
                    if is_strategic:
                        if len(trades) < 3: await self.seek_entries(lnm, account.balance, rsi, price)
                        self.last_strategic_run = now
                await asyncio.sleep(self.fast_cycle_minutes * 60)
            except Exception as e:
                print(f"❌ Error: {e}")
                await asyncio.sleep(60)

    async def audit_position(self, lnm, pos, rsi, price):
        try:
            prompt = f"AUDIT: {pos.side} | RSI: {rsi} | PnL: {pos.pl}. JSON."
            resp = self.client_gemini.models.generate_content(model=self.model_name, contents=prompt)
            d = json.loads(resp.text.replace('```json', '').replace('```', '').strip())
            if d.get("action") == "CLOSE_POSITION":
                await lnm.futures.isolated.close({"id": pos.id})
                self.notifier.send_alert(f"🚨 IA Cerró: {pos.pl} SATS")
        except: pass

    async def seek_entries(self, lnm, balance, rsi, price):
        if rsi == 50.0 and len(self.price_history) < 14:
            print("⏳ Esperando acumular ticks para RSI real...")
            return
        try:
            prompt = f"SNIPER: RSI {rsi} | Price {price}. JSON."
            resp = self.client_gemini.models.generate_content(model=self.model_name, contents=prompt)
            d = json.loads(resp.text.replace('```json', '').replace('```', '').strip())
            if d.get("action") in ["BUY", "SELL"]:
                order = FuturesOrder(
                    type='market', side=d['action'].lower(), margin=1000, leverage=10,
                    stoploss=self.round_to_tick(d.get('stop_loss')), takeprofit=self.round_to_tick(d.get('take_profit'))
                )
                await lnm.futures.isolated.new_trade(order)
                self.notifier.send_alert(f"🚀 Sniper {d['action']} @ ${price} (RSI: {rsi})")
        except: pass

if __name__ == "__main__":
    engine = G9SentinelEngine()
    asyncio.run(engine.run_trading_cycle())
